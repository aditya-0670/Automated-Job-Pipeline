{
  "uid": "resumeforge-pipeline",
  "title": "ResumeForge \u2014 pipeline",
  "tags": [
    "resumeforge"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Is it working?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "Pipeline runs",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(resumeforge_pipeline_runs_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Started, completed and failed. A gap between started and completed that does not close is sessions stuck mid-run."
    },
    {
      "id": 2,
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(resumeforge_pipeline_runs_total{outcome=\"failed\"}[10m])) / clamp_min(sum(rate(resumeforge_pipeline_runs_total{outcome=~\"completed|failed\"}[10m])), 0.0001)",
          "legendFormat": "failed share",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "clamp_min avoids a divide-by-zero rendering as a spike to infinity on an idle system."
    },
    {
      "id": 3,
      "title": "Sessions awaiting a person",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(resumeforge_sessions_awaiting_input) by (gate)",
          "legendFormat": "{{gate}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Not an error: the pipeline is designed to stop and wait. Worth watching because these hold checkpoints, not connections."
    },
    {
      "id": 101,
      "type": "row",
      "title": "Is it slow?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Pipeline duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(resumeforge_pipeline_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(resumeforge_pipeline_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Per invocation, not per session: a session paused for a human and resumed later would otherwise report the length of their coffee break."
    },
    {
      "id": 5,
      "title": "Time per node (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(resumeforge_node_duration_seconds_bucket[10m])) by (le, node))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "description": "\"Slow\" almost always means one node, and an average over the pipeline hides which."
    },
    {
      "id": 102,
      "type": "row",
      "title": "What is it costing?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "id": 6,
      "title": "Tokens per minute, by step",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(resumeforge_llm_tokens_total[5m])) by (step) * 60",
          "legendFormat": "{{step}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "The number that becomes a bill. The deterministic extraction layer exists to keep this down; if extraction ever appears here, something regressed."
    },
    {
      "id": 7,
      "title": "Tokens by kind",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(resumeforge_llm_tokens_total[1h])) by (kind)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Thinking tokens are billed as output on Gemini 3.x but tracked separately: they are the line item that moves when a thinking budget changes."
    },
    {
      "id": 8,
      "title": "Model calls",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(resumeforge_llm_calls_total[5m])) by (model, outcome)",
          "legendFormat": "{{model}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "A build-up of `fallback` is the early warning that the primary model's daily quota is running out."
    },
    {
      "id": 103,
      "type": "row",
      "title": "Is the model behaving?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "id": 9,
      "title": "Guardrail rejections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(resumeforge_guardrail_failures_total[10m])) by (kind)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Invisible in the error rate, because the pipeline handles them. A rise in `factual` means the model started claiming things the evidence does not support."
    },
    {
      "id": 10,
      "title": "Refactor attempts per session (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(resumeforge_self_correction_iterations_bucket[10m])) by (le))",
          "legendFormat": "p95 attempts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "1 means right first time. Trending toward the cap means the self-correction loop is carrying the model."
    },
    {
      "id": 11,
      "title": "Extraction latency (p95) \u2014 zero tokens",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(resumeforge_extraction_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "description": "The Aho-Corasick path. Costs no tokens by construction, so this panel is latency only."
    },
    {
      "id": 104,
      "type": "row",
      "title": "The gateway",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      }
    },
    {
      "id": 12,
      "title": "Request duration (p95) by route",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(resumeforge_api_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Refusals",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(resumeforge_api_auth_failures_total[5m])) by (reason)",
          "legendFormat": "auth {{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(resumeforge_api_rate_limited_total[5m])) by (limiter)",
          "legendFormat": "rate limit {{limiter}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Open event streams",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(resumeforge_api_event_streams_total{event=\"opened\"}) - sum(resumeforge_api_event_streams_total{event=\"closed\"})",
          "legendFormat": "open",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Opens minus closes. A number that only grows is leaked upstream connections and Postgres polls on the AI service."
    }
  ]
}
