# ─── Database ───
POSTGRES_USER=resumeforge
POSTGRES_PASSWORD=resumeforge
POSTGRES_DB=resumeforge
DATABASE_URL=postgresql://resumeforge:resumeforge@postgres:5432/resumeforge

# ─── Redis ───
REDIS_URL=redis://redis:6379

# ─── LLM (Google Gemini) ───
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Service wiring ───
AI_SERVICE_URL=http://ai:8000
INTERNAL_API_KEY=dev-internal-key-change-me
API_PORT=4000
AI_PORT=8000

# ─── Auth (dev mode: single seeded user) ───
AUTH_MODE=dev
JWT_SECRET=dev-jwt-secret-change-me
DEV_USER_EMAIL=ta.curriculum@zenithschool.ai

# ─── GitHub sync (PAT, not OAuth, for MVP) ───
GITHUB_USERNAME=
GITHUB_TOKEN=

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:4000
