# ─── Database ───
POSTGRES_USER=resumeforge
POSTGRES_PASSWORD=resumeforge
POSTGRES_DB=resumeforge
DATABASE_URL=postgresql://resumeforge:resumeforge@postgres:5432/resumeforge

# The API service points at the same database through its own Postgres schema.
# `?schema=app` is not optional: Prisma owns every table in `app`, LangGraph owns
# the checkpoint tables in `public`, and without the parameter Prisma sees tables
# it did not create and refuses to migrate (P3005).
API_DATABASE_URL=postgresql://resumeforge:resumeforge@postgres:5432/resumeforge?schema=app
SEED_USER_EMAIL=aditya@resumeforge.dev

# ─── Redis ───
REDIS_URL=redis://redis:6379

# ─── LLM (Google Gemini) ───
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
LLM_THINKING_BUDGET=512
LLM_MAX_OUTPUT_TOKENS=16384

# ─── Service wiring ───
AI_SERVICE_URL=http://ai:8000
INTERNAL_API_KEY=dev-internal-key-change-me
API_PORT=4000
AI_PORT=8000

# ─── Auth (dev mode: single seeded user) ───
AUTH_MODE=dev
JWT_SECRET=dev-jwt-secret-change-me
DEV_USER_EMAIL=ta.curriculum@zenithschool.ai

# ─── Secrets at rest ───
# Encrypts stored GitHub PATs (AES-256-GCM). Separate from JWT_SECRET: one signs
# short-lived tokens and rotates freely, the other is all that stands between a
# database dump and a usable credential.
ENCRYPTION_KEY=dev-encryption-key-change-me-32b

# ─── GitHub sync (PAT, not OAuth, for MVP) ───
GITHUB_SYNC_TTL_MINUTES=60
GITHUB_USERNAME=
GITHUB_TOKEN=

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:4000
# Origins allowed to call the API from a browser. An allowlist and not `*`: a
# bearer token in localStorage is only useful from a page we served.
WEB_ORIGINS=http://localhost:3000

# ─── Jenkins (Part 18) ───
# The host's docker group id, so the Jenkins container can use the socket.
# Differs per distribution: stat -c '%g' /var/run/docker.sock
DOCKER_GID=988
JENKINS_PORT=8080
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
